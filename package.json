{
  "name": "material-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "go run ./cmd/server",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:server": "go build -o ./bin/server.exe ./cmd/server",
    "build": "vite build && go build -o ./bin/server.exe ./cmd/server",
    "start": "./bin/server.exe",
    "db:seed": "go run ./cmd/server --seed"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.67.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.29.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
